#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.6.1"
    }
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "seeed_bearing__configuration__22x16x4_material"
    {
        color3f inputs:diffuseColor = (0.623961, 0.70837677, 0.78353727)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/seeed_bearing__configuration__22x16x4_material/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/seeed_bearing__configuration__22x16x4_material.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/seeed_bearing__configuration__22x16x4_material.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/seeed_bearing__configuration__22x16x4_material.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/seeed_bearing__configuration__22x16x4_material.inputs:roughness>
            token outputs:surface
        }
    }

