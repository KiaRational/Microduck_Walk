#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.6.1"
    }
    defaultPrim = "microduck_nav"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "microduck_nav"
{
    over "Geometry"
    {
        over "trunk_base" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
