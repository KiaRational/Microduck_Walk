#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.6.1"
    }
    defaultPrim = "microduck_nav"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "microduck_nav"
{
    over "Geometry"
    {
        over "trunk_base"
        {
            over "yaw2roll"
            {
                over "hip_l"
                {
                    over "upper_leg_left"
                    {
                        over "leg"
                        {
                            over "ankle_left"
                            {
                                over "left_ankle" (
                                    prepend apiSchemas = ["PhysxJointAPI"]
                                )
                                {
                                }
                            }

                            over "left_knee" (
                                prepend apiSchemas = ["PhysxJointAPI"]
                            )
                            {
                            }
                        }

                        over "left_hip_pitch" (
                            prepend apiSchemas = ["PhysxJointAPI"]
                        )
                        {
                        }
                    }

                    over "left_hip_roll" (
                        prepend apiSchemas = ["PhysxJointAPI"]
                    )
                    {
                    }
                }

                over "left_hip_yaw" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                }
            }

            over "neck"
            {
                over "neck_pitch_1"
                {
                    over "yaw_roll_motion"
                    {
                        over "jaw_soft"
                        {
                            over "head_roll" (
                                prepend apiSchemas = ["PhysxJointAPI"]
                            )
                            {
                            }
                        }

                        over "head_yaw" (
                            prepend apiSchemas = ["PhysxJointAPI"]
                        )
                        {
                        }
                    }

                    over "head_pitch" (
                        prepend apiSchemas = ["PhysxJointAPI"]
                    )
                    {
                    }
                }

                over "neck_pitch" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                }
            }

            over "bearing_roll"
            {
                over "hip_l_2"
                {
                    over "upper_leg_right"
                    {
                        over "leg_2"
                        {
                            over "ankle_right"
                            {
                                over "right_ankle" (
                                    prepend apiSchemas = ["PhysxJointAPI"]
                                )
                                {
                                }
                            }

                            over "right_knee" (
                                prepend apiSchemas = ["PhysxJointAPI"]
                            )
                            {
                            }
                        }

                        over "right_hip_pitch" (
                            prepend apiSchemas = ["PhysxJointAPI"]
                        )
                        {
                        }
                    }

                    over "right_hip_roll" (
                        prepend apiSchemas = ["PhysxJointAPI"]
                    )
                    {
                    }
                }

                over "right_hip_yaw" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                }
            }
        }
    }
}

